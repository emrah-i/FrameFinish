{
  "name": "frame-finish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "WRANGLER_SEND_METRICS=false wrangler dev --local --env staging",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "build": "vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
    "build:preview": "vite build --mode local-preview && vite build --mode local-preview --ssr src/entry-server.tsx && node scripts/prerender.mjs --preview",
    "check:release": "node scripts/check-release.mjs",
    "deploy": "npm run build && npm run check:release && wrangler deploy --env production",
    "smoke:local": "node scripts/smoke-local.mjs",
    "photos:prepare": "node scripts/prepare-photos.mjs"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "embla-carousel-auto-scroll": "8.6.0",
    "embla-carousel-solid": "8.6.0",
    "hono": "4.13.16",
    "motion": "14.9.1",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.15",
    "vitest": "3.2.7",
    "wrangler": "4.157.0"
  }
}
